# SDE Automation Pipeline — Environment Variables
# Copy this file to .env and fill in your values.

# AWS Bedrock (for Claude content synthesis)
# AWS_PROFILE: name of your AWS CLI profile (run: aws configure --profile <name>)
# AWS_REGION: region with Bedrock Claude access (e.g. us-east-1, us-east-2)
# BEDROCK_MODEL_ID: inference profile ID (must use us. prefix format)
AWS_PROFILE=dev-us-aws-bedrock
AWS_DEFAULT_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Research APIs (for automated daily news gathering)
# Perplexity: Sign up at https://www.perplexity.ai/settings/api
# Searches both English and Vietnamese sources automatically
PERPLEXITY_API_KEY=pplx-your-api-key-here

# Manus AI: Optional web scraping service for Vietnamese local news
# Leave blank if not configured — pipeline will skip Manus AI
MANUS_API_KEY=your_manus_api_key_here

# Telegram Bot (create via @BotFather, then get the channel ID)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-1001234567890

# Facebook Page (optional — leave blank to skip Facebook publishing)
# Page ID: found in your Facebook Page settings or URL
# Page Access Token: generated via Meta Developer App with pages_manage_posts permission
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_PAGE_TOKEN=your_page_access_token_here

# Campaign URLs
CHANGE_ORG_URL=https://www.change.org/p/end-dog-meat-trade-vietnam
WEBSITE_URL=https://stopdogeaters.info
